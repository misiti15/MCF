# Copy to .env and fill in. Never commit the real file.
TRIVIA_BRAND="Deep Cut"
TRIVIA_PUBLIC_URL=https://your-domain.example
TRIVIA_SERVE_DRAFTS=1

# Email drops (free tiers work: Brevo, Resend SMTP, or a Gmail app password for testing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Text-message drops (Twilio). Leave empty until the number is registered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
